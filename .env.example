# ==============================================================================
# Environment Configuration Example for LoRA Sentiment Classification API
# ==============================================================================

# Application Settings
APP_NAME="DistilBERT LoRA Sentiment Classification API"
APP_VERSION="1.0.0"
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Model & Adapter Paths
BASE_MODEL_NAME_OR_PATH="distilbert/distilbert-base-uncased"
ADAPTER_PATH="Models/lora-sst2-adapter"

# Device Configuration: "auto" selects MPS (Apple Silicon), CUDA, or CPU fallback
DEVICE="auto"

# CORS Allowed Origins (comma-separated list for local & production origins)
FRONTEND_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://lora-sentiment-ai.vercel.app"

# Tokenization & Inference Settings
MAX_SEQUENCE_LENGTH=128
EXPECTED_LORA_RANK=16
DECIMAL_PRECISION=4
MAX_BATCH_SIZE=32
MAX_INPUT_CHAR_LENGTH=1000
